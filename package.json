{
  "name": "@penzack/quality-gates",
  "version": "0.1.0",
  "description": "Shared code-quality gates for Penzack frontend projects: ESLint rules, jscpd/knip base configs and a reusable GitHub quality workflow",
  "type": "module",
  "main": "eslint/index.mjs",
  "exports": {
    ".": "./eslint/index.mjs",
    "./jscpd": "./configs/jscpd.base.json",
