  "files": [
    "eslint",
    "configs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/penzack-homebroker/quality-gates.git"
  },
  "dependencies": {
    "eslint-plugin-sonarjs": "^4.2.0"
  },
  "peerDependencies": {
    "eslint": ">=9.24.0"
  },
  "license": "UNLICENSED",
